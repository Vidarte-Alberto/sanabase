generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Patient {
  id                 String @id
  fullName           String
  age                Int
  gender             String
  birthDate          String
  phone              String
  address            String
  email              String
  bloodType          String
  allergies          String
  medicalHistory     String
  consultationReason String
  notes              String
  registrationDate   String
  lastUpdated        String

  @@map("patients")
}

model User {
  id           String @id
  username     String @unique
  displayName  String
  role         String
  passwordHash String
  createdAt    String
  lastUpdated  String

  @@map("users")
}

model LoginRateLimit {
  key            String @id
  failedAttempts Int
  blockedUntil   String?
  createdAt      String
  lastUpdated    String

  @@map("login_rate_limits")
}

model Consultation {
  id          String @id
  patientId   String
  userId      String
  date        String
  reason      String
  diagnosis   String
  treatment   String
  notes       String
  createdAt   String
  lastUpdated String

  @@map("consultations")
}

model Payment {
  id             String  @id
  patientId      String
  userId         String
  shiftId        String?
  appointmentId  String?
  consultationId String?
  amount         Float
  concept        String
  paymentMethod  String
  date           String
  createdAt      String

  @@map("payments")
}

model Shift {
  id        String  @id
  userId    String
  startTime String
  endTime   String?
  status    String
  notes     String

  @@map("shifts")
}

model Appointment {
  id          String @id
  patientId   String
  userId      String
  dateTime    String
  reason      String
  status      String
  notes       String
  createdAt   String
  lastUpdated String

  @@map("appointments")
}
